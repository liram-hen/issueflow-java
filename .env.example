SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=issueflow
DB_USERNAME=issueflow
DB_PASSWORD=issueflow

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SPRING_DOCKER_COMPOSE_ENABLED=true

JWT_SECRET=issueflow-development-secret-key-change-me-32-chars-minimum
JWT_EXPIRES_IN_SECONDS=3600

MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# Bootstrap admin (seeded on first startup when the users table is empty).
# Change BOOTSTRAP_ADMIN_PASSWORD before any non-local deployment.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_EMAIL=admin@issueflow.local
